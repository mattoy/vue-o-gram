{
  "name": "vue-o-gram",
  "version": "1.2.0",
  "type": "module",
  "description": "A Vue 3 component for interactive treemap visualizations",
  "main": "./dist/vue-o-gram.umd.js",
  "module": "./dist/vue-o-gram.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-o-gram.es.js",
      "require": "./dist/vue-o-gram.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "treemap",
    "visualization",
    "component"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/vue": "^8.1.0",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/language-core": "^3.3.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-fp": "^2.3.0",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.10"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
